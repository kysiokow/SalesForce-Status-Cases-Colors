{
  "author": {
      "email": "k.kowalski78@icloud.com",
      "name": "Krzysztof Kowalski"
   },
  "manifest_version": 3,
  "name": "SALES Force THEME",
  "version": "2.0.0",
  "description": "User-configurable colors for Salesforce statuses with auto language detection (PL/FR/EN).",

  "icons": {
    "16": "logo/logo_16.png",
    "24": "logo/logo_24.png",
    "36": "logo/logo_36.png",
    "48": "logo/logo_48.png",
    "64": "logo/logo_64.png",
    "128": "logo/logo_128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Ustaw swoje kolory"
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.force.com/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "css": [
        "css/styles.css"
      ]
    }
  ]
}